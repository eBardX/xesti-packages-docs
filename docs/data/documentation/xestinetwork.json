{"sections":[],"abstract":[{"type":"text","text":"A simple network abstraction layer."}],"topicSections":[{"title":"Requests","identifiers":["doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/Endpoint","doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/Endpoint\/DataSource-swift.enum"],"anchor":"Requests"},{"title":"Sending requests","identifiers":["doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/Foundation\/URLSession\/data(for:delegate:)","doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/Foundation\/URLSession\/bytes(for:delegate:)","doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/Foundation\/URLSession\/download(for:delegate:)","doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/Foundation\/URLSession\/upload(for:delegate:)"],"anchor":"Sending-requests"},{"title":"Type-safe names","identifiers":["doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/HTTPMethod","doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/HTTPHeaderName","doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/ParameterName","doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/ContentType"],"anchor":"Type-safe-names"},{"title":"Errors","identifiers":["doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/NetworkError"],"anchor":"Errors"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"The XestiNetwork framework provides a simple network abstraction layer for"},{"type":"text","text":" "},{"type":"text","text":"Swift."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Inspired by Moya, but without the nonsense (and without the cruft of"},{"type":"text","text":" "},{"type":"text","text":"Alamofire)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/Endpoint"},{"type":"text","text":" describes everything needed to build and validate a single"},{"type":"text","text":" "},{"type":"text","text":"HTTP request — its URL, method, headers, query parameters, cache policy,"},{"type":"text","text":" "},{"type":"text","text":"timeout, and (for uploads) its data source — as well as the status codes and"},{"type":"text","text":" "},{"type":"text","text":"content types that make a response acceptable. Extensions on "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"then let you send an endpoint directly:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let (data, response) = try await session.data(for: endpoint)"]},{"inlineContent":[{"type":"text","text":"Endpoints are built from type-safe names rather than raw strings —"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/HTTPMethod"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/HTTPHeaderName"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/ParameterName"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/ContentType"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"so a mistyped header name or method fails to compile instead of failing at"},{"type":"text","text":" "},{"type":"text","text":"runtime. Each of these types is open-ended: a small set of standard values"},{"type":"text","text":" "},{"type":"text","text":"ships with the framework, and you add your own with a "},{"type":"codeVoice","code":"static let"},{"type":"text","text":" in an"},{"type":"text","text":" "},{"type":"text","text":"extension."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import XestiNetwork","","var endpoint = Endpoint(baseURL: URL(string: \"https:\/\/api.example.com\")!,","                        path: \"\/v1\/status\")","","endpoint.headers = [.authorization: \"Bearer \\(token)\"]","","let (data, response) = try await URLSession.shared.data(for: endpoint)"]},{"inlineContent":[{"type":"text","text":"If the response’s status code isn’t in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/Endpoint\/acceptableStatusCodes"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"its content type isn’t in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/Endpoint\/acceptableContentTypes"},{"type":"text","text":", the call"},{"type":"text","text":" "},{"type":"text","text":"throws a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/NetworkError"},{"type":"text","text":" instead of handing you a response you’d have to"},{"type":"text","text":" "},{"type":"text","text":"validate yourself."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiNetwork\/documentation\/XestiNetwork\/Endpoint"},{"type":"text","text":" for the full details of how a request is constructed, and"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" extension methods for how it’s sent and validated."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/xestinetwork"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[[]]},"metadata":{"title":"XestiNetwork","symbolKind":"module","role":"collection","roleHeading":"Framework","color":{"standardColorIdentifier":"blue"},"modules":[{"name":"XestiNetwork"}],"externalID":"XestiNetwork"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/XestiNetwork\/documentation\/Xes