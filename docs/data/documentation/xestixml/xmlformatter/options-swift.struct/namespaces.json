{"variants":[{"paths":["\/documentation\/xestixml\/xmlformatter\/options-swift.struct\/namespaces"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/XestiXML\/documentation\/XestiXML","doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter","doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"namespaces"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Namespace","preciseIdentifier":"s:8XestiXML12XMLFormatterV9NamespaceV","kind":"typeIdentifier","text":"Namespace"},{"kind":"text","text":"]"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode","isActive":true,"type":"reference"},{"type":"text","text":" tree records namespace URIs, never prefixes, so the"},{"type":"text","text":" "},{"type":"text","text":"formatter chooses the prefixes. Every declaration is written on the"},{"type":"text","text":" "},{"type":"text","text":"root element, and this option says what those declarations are. It"},{"type":"text","text":" "},{"type":"text","text":"need not be exhaustive, and it is empty by default."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A URI not listed here is still written correctly. It becomes the"},{"type":"text","text":" "},{"type":"text","text":"default namespace if "},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"type":"text","text":" element in the tree carries it;"},{"type":"text","text":" "},{"type":"text","text":"otherwise it receives a generated prefix ("},{"code":"ns1","type":"codeVoice"},{"type":"text","text":", "},{"code":"ns2","type":"codeVoice"},{"type":"text","text":", and so on)"},{"type":"text","text":" "},{"type":"text","text":"assigned in document order. So a document using a single namespace"},{"type":"text","text":" "},{"type":"text","text":"throughout needs no configuration at all."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The prefix "},{"code":"xml","type":"codeVoice"},{"type":"text","text":" is bound to the XML namespace permanently and"},{"type":"text","text":" "},{"type":"text","text":"implicitly. It need not be declared, and cannot be bound to any other"},{"type":"text","text":" "},{"type":"text","text":"URI."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note that "},{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Error\/invalidNamespace(_:_:)","isActive":true,"type":"reference"},{"type":"text","text":" is thrown if a prefix is"},{"type":"text","text":" "},{"type":"text","text":"not a valid XML name without a colon, if a URI is empty, or if the"},{"type":"text","text":" "},{"type":"text","text":"same prefix or the same URI is bound twice."}],"type":"paragraph"}]}],"metadata":{"externalID":"s:8XestiXML12XMLFormatterV7OptionsV10namespacesSayAC9NamespaceVyxq__GGvp","symbolKind":"property","title":"namespaces","role":"symbol","roleHeading":"Instance Property","modules":[{"name":"XestiXML"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"namespaces"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8XestiXML12XMLFormatterV9NamespaceV","kind":"typeIdentifier","text":"Namespace"},{"kind":"text","text":"]"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"The prefixes to bind to the namespace URIs appearing in the XML node"},{"type":"text","text":" "},{"type":"text","text":"tree."}],"identifier":{"url":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct\/namespaces","interfaceLanguage":"swift"},"sections":[],"