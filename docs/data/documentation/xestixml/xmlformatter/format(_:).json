oximated or dropped.","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Error","type":"reference","isActive":true},{"type":"text","text":" if the XML document cannot be formatted."}],"type":"paragraph"}],"name":"Throws"}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/xestixml\/xmlformatter\/format(_:)"]}],"identifier":{"url":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/format(_:)","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/XestiXML\/documentation\/XestiXML","doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter"]]},"metadata":{"roleHeading":"Instance Method","externalID":"s:8XestiXML12XMLFormatterV6formaty10Foundation4DataVAA11XMLDocumentVyxq_GAC5ErrorOyxq__GYKF","symbolKind":"method","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"format","kind":"identifier"},{"text":"(","kind":"text"},{"text":"XMLDocument","preciseIdentifier":"s:8XestiXML11XMLDocumentV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"E","preciseIdentifier":"s:8XestiXML12XMLFormatterV1Exmfp","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"A","preciseIdentifier":"s:8XestiXML12XMLFormatterV1Aq_mfp","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Error","preciseIdentifier":"s:8XestiXML12XMLFormatterV5ErrorO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"}],"title":"format(_:)","modules":[{"name":"XestiXML"}],"extendedModule":"XestiXML","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"E","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"XMLElement","type":"codeVoice"},{"tex