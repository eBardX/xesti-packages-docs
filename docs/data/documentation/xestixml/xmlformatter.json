ntifier"}],"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"XMLParser"}]},"doc://XestiXML/documentation/XestiXML/XMLFormatter/Options-swift.struct/emitsXMLDeclaration":{"title":"emitsXMLDeclaration","abstract":[{"type":"text","text":"A Boolean value indicating whether the formatted XML document is"},{"type":"text","text":" "},{"type":"text","text":"preceded by an XML declaration."}],"kind":"symbol","type":"topic","url":"\/documentation\/xestixml\/xmlformatter\/options-swift.struct\/emitsxmldeclaration","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct\/emitsXMLDeclaration","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"emitsXMLDeclaration","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]}}}