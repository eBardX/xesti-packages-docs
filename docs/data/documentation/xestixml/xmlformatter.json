{"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/XestiXML\/s8SendableP","doc:\/\/XestiXML\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"seeAlsoSections":[{"title":"Parsing and formatting","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser"],"anchor":"Parsing-and-formatting","generated":true}],"abstract":[{"type":"text","text":"A simplified XML formatter."}],"identifier":{"url":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"XMLFormatter","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"A","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"XMLElement","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLElement","kind":"typeIdentifier","preciseIdentifier":"s:8XestiXML10XMLElementP"},{"text":", ","kind":"text"},{"text":"A","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"XMLAttribute","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute","kind":"typeIdentifier","preciseIdentifier":"s:8XestiXML12XMLAttributeP"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"XMLFormatter"},{"type":"text","text":" serializes a type-safe tree of "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode","isActive":true},{"type":"text","text":" instances into an"},{"type":"text","text":" "},{"type":"text","text":"XML document. It is the inverse of "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser","isActive":true},{"type":"text","text":" and, as such, is equally"},{"type":"text","text":" "},{"inlineContent":[{"text":"simple","type":"text"}],"type":"emphasis"},{"type":"text","text":" in that only elements, with any associated attributes, text,"},{"type":"text","text":" "},{"type":"text","text":"comments, and processing instructions are represented in the resulting XML"},{"type":"text","text":" "},{"type":"text","text":"document. Other XML items (such as CDATA blocks and the declarations within"},{"type":"text","text":" "},{"type":"text","text":"the internal subset of a document type declaration) cannot be generated."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Elements and attributes are mapped from custom "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLElement","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute","isActive":true},{"type":"text","text":" types, respectively."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each comment and processing instruction in the XML node tree is emitted"},{"type":"text","text":" "},{"type":"text","text":"where it appears unless "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct\/stripsComments","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct\/stripsProcessingInstructions","isActive":true},{"type":"text","text":" is enabled, in which case it is"},{"type":"text","text":" "},{"type":"text","text":"omitted. These mirror the options of the same name on "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser","isActive":true},{"type":"text","text":", so a"},{"type":"text","text":" "},{"type":"text","text":"tree may be stripped as it is parsed, as it is formatted, or both."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/format(_:)","isActive":true},{"type":"text","text":" takes an "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLDocument","isActive":true},{"type":"text","text":", so an entire XML document is"},{"type":"text","text":" "},{"type":"text","text":"emitted — including its document type declaration and anything in its"},{"type":"text","text":" "},{"type":"text","text":"prolog and epilog. Wrap a bare "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode","isActive":true},{"type":"text","text":" in "},{"type":"codeVoice","code":"XMLDocument(root:)"},{"type":"text","text":" to format"},{"type":"text","text":" "},{"type":"text","text":"an XML node tree with no such surroundings."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode","isActive":true},{"type":"text","text":" tree records namespace "},{"inlineContent":[{"type":"text","text":"URIs"}],"type":"emphasis"},{"type":"text","text":", never prefixes, so the"},{"type":"text","text":" "},{"type":"text","text":"prefixes are chosen here. Every namespace declaration is emitted on the root"},{"type":"text","text":" "},{"type":"text","text":"element, and "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct\/namespaces","isActive":true},{"type":"text","text":" says what those declarations are. A URI"},{"type":"text","text":" "},{"type":"text","text":"left unmentioned is still written correctly: it becomes the default"},{"type":"text","text":" "},{"type":"text","text":"namespace if every element in the tree carries it, and otherwise receives a"},{"type":"text","text":" "},{"type":"text","text":"generated prefix. A document using a single namespace throughout therefore"},{"type":"text","text":" "},{"type":"text","text":"needs no configuration, and is written exactly as it would be by hand."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two consequences are worth stating plainly. An attribute in a namespace is"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"always"}],"type":"emphasis"},{"type":"text","text":" written with a prefix, even when its URI is also the default"},{"type":"text","text":" "},{"type":"text","text":"namespace, because an unprefixed attribute name is in no namespace at all."},{"text":" ","type":"text"},{"text":"And a namespace declaration cannot be written as an ordinary attribute: any","type":"text"},{"text":" ","type":"text"},{"text":"attribute name beginning with ","type":"text"},{"code":"xmlns","type":"codeVoice"},{"text":" is rejected as reserved.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that a document using more than one namespace does not survive a parse"},{"type":"text","text":" "},{"type":"text","text":"and reformat byte for byte, since the prefixes it is written with are chosen"},{"type":"text","text":" "},{"type":"text","text":"rather than recovered. What survives is meaning — every name resolves to the"},{"type":"text","text":" "},{"type":"text","text":"namespace it resolved to before — and formatting is idempotent thereafter."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An emitted XML declaration is always a complete one, naming a version, an"},{"type":"text","text":" "},{"type":"text","text":"encoding, and whether the document is standalone, whatever the"},{"type":"text","text":" "},{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLDeclaration","type":"reference","isActive":true},{"type":"text","text":" being formatted left out. Each omission has a value the"},{"type":"text","text":" "},{"type":"text","text":"XML specification assumes on a reader’s behalf — UTF-8 for an unnamed"},{"type":"text","text":" "},{"type":"text","text":"encoding, "},{"type":"codeVoice","code":"no"},{"type":"text","text":" for an absent "},{"type":"codeVoice","code":"standalone"},{"type":"text","text":" — so writing them out states what"},{"type":"text","text":" "},{"type":"text","text":"the document already meant, and leaves nothing about how it is to be read"},{"type":"text","text":" "},{"type":"text","text":"resting on a default the reader has to know. A declaration that named only a"},{"type":"text","text":" "},{"type":"text","text":"version therefore does not come back byte for byte, though it comes back"},{"type":"text","text":" "},{"type":"text","text":"saying the same thing, and formatting is idempotent thereafter."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The bytes produced are in the character encoding named by the XML"},{"type":"text","text":" "},{"type":"text","text":"declaration that is emitted, since that declaration is all a reader has to go"},{"type":"text","text":" "},{"type":"text","text":"by. A document is therefore written in UTF-8 unless its "},{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLDocument","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"carries an "},{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLDeclaration","type":"reference","isActive":true},{"type":"text","text":" naming some other encoding "},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct\/emitsXMLDeclaration"},{"type":"text","text":" is enabled — bytes nobody can decode are of"},{"type":"text","text":" "},{"type":"text","text":"no use to anyone, so suppressing the declaration also suppresses the choice"},{"type":"text","text":" "},{"type":"text","text":"of encoding. The encoding must be one the system knows by the IANA charset"},{"type":"text","text":" "},{"type":"text","text":"name the declaration spells it with, and it must be one an XML parser can be"},{"type":"text","text":" "},{"type":"text","text":"expected to read back, which rules out the UTF-32 family."}]},{"inlineContent":[{"text":"An encoding narrower than Unicode need not be able to carry every character","type":"text"},{"text":" ","type":"text"},{"text":"in the document. In text and attribute values, one it cannot carry is written","type":"text"},{"text":" ","type":"text"},{"text":"as a numeric character reference — ","type":"text"},{"code":"caf&#xe9;","type":"codeVoice"},{"text":" in US-ASCII — which a parser","type":"text"},{"text":" ","type":"text"},{"text":"reads back as the character itself, so the document survives an encoding that","type":"text"},{"text":" ","type":"text"},{"text":"has never heard of it. Everywhere else, it does not: a reference is markup,","type":"text"},{"text":" ","type":"text"},{"text":"and inside an element name, a comment, or a processing instruction it would","type":"text"},{"text":" ","type":"text"},{"text":"be read as the literal characters that spell it. A name or a comment the","type":"text"},{"text":" ","type":"text"},{"text":"encoding cannot carry is therefore an error rather than an approximation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Attributes are always emitted in ascending order by name and namespace URI,","type":"text"},{"text":" ","type":"text"},{"text":"so formatting the same XML node tree twice always produces identical","type":"text"},{"text":" ","type":"text"},{"text":"results.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An ","type":"text"},{"code":"XMLFormatter","type":"codeVoice"},{"text":" instance is immutable and may be used to format any number","type":"text"},{"text":" ","type":"text"},{"text":"of XML node trees concurrently.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/XestiXML\/documentation\/XestiXML"]]},"kind":"symbol","metadata":{"role":"symbol","title":"XMLFormatter","modules":[{"name":"XestiXML"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"XMLFormatter","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"XMLFormatter"}],"symbolKind":"struct","externalID":"s:8XestiXML12XMLFormatterV","roleHeading":"Structure"},"variants":[{"paths":["\/documentation\/xestixml\/xmlformatter"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Namespace","doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct"],"generated":true,"title":"Structures","anchor":"Structures"},{"title":"Initializers","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/init(options:)"],"anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/options-swift.property"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/format(_:)"],"anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Error"],"generated":true,"title":"Enumerations","anchor":"Enumerations"}],"references":{"doc://XestiXML/documentation/XestiXML/XMLNode":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"XMLNode"}],"abstract":[{"type":"text","text":"A node in the abstract, logical tree structure that represents an XML"},{"type":"text","text":" "},{"type":"text","text":"document."}],"kind":"symbol","url":"\/documentation\/xestixml\/xmlnode","navigatorTitle":[{"kind":"identifier","text":"XMLNode"}],"role":"symbol","type":"topic","title":"XMLNode","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode"},"doc://XestiXML/documentation/XestiXML/XMLFormatter/Options-swift.struct":{"kind":"symbol","title":"XMLFormatter.Options","abstract":[{"text":"The options that control how an ","type":"text"},{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter","isActive":true,"type":"reference"},{"text":" instance formats an XML","type":"text"},{"text":" ","type":"text"},{"text":"document.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Options"}],"url":"\/documentation\/xestixml\/xmlformatter\/options-swift.struct","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Options"}],"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"E"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"XMLElement"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"A"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"XMLAttribute"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]}},"doc://XestiXML/documentation/XestiXML/XMLFormatter/options-swift.property":{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/options-swift.property","url":"\/documentation\/xestixml\/xmlformatter\/options-swift.property","role":"symbol","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"options","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8XestiXML12XMLFormatterV7OptionsV","text":"Options","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"The options that control how an XML document is formatted."}],"title":"options"},"doc://XestiXML/documentation/Xe