{"seeAlsoSections":[{"identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser"],"title":"Parsing and formatting","anchor":"Parsing-and-formatting","generated":true}],"hierarchy":{"paths":[["doc:\/\/XestiXML\/documentation\/XestiXML"]]},"abstract":[{"text":"A simplified XML formatter.","type":"text"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/XestiXML\/s8SendableP","doc:\/\/XestiXML\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"variants":[{"paths":["\/documentation\/xestixml\/xmlformatter"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Namespace","doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct"],"title":"Structures","anchor":"Structures","generated":true},{"identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/init(options:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/options-swift.property"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/format(_:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Error"],"title":"Enumerations","anchor":"Enumerations","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"XMLFormatter","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"A","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:8XestiXML10XMLElementP","text":"XMLElement","kind":"typeIdentifier","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLElement"},{"text":", ","kind":"text"},{"text":"A","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:8XestiXML12XMLAttributeP","text":"XMLAttribute","kind":"typeIdentifier","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"XMLFormatter"},{"type":"text","text":" serializes a type-safe tree of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode"},{"type":"text","text":" instances into an"},{"type":"text","text":" "},{"type":"text","text":"XML document. It is the inverse of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser"},{"type":"text","text":" and, as such, is equally"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"simple","type":"text"}]},{"type":"text","text":" in that only elements, with any associated attributes, text,"},{"type":"text","text":" "},{"type":"text","text":"comments, and processing instructions are represented in the resulting XML"},{"type":"text","text":" "},{"type":"text","text":"document. Other XML items (such as CDATA blocks and the declarations within"},{"type":"text","text":" "},{"type":"text","text":"the internal subset of a document type declaration) cannot be generated."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Elements and attributes are mapped from custom "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLElement"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute"},{"type":"text","text":" types, respectively."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each comment and processing instruction in the XML node tree is emitted"},{"type":"text","text":" "},{"type":"text","text":"where it appears unless "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct\/stripsComments"},{"type":"text","text":" or"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct\/stripsProcessingInstructions"},{"type":"text","text":" is enabled, in which case it is"},{"type":"text","text":" "},{"type":"text","text":"omitted. These mirror the options of the same name on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser"},{"type":"text","text":", so a"},{"type":"text","text":" "},{"type":"text","text":"tree may be stripped as it is parsed, as it is formatted, or both."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/format(_:)"},{"type":"text","text":" takes an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLDocument"},{"type":"text","text":", so an entire XML document is"},{"type":"text","text":" "},{"type":"text","text":"emitted — including its document type declaration and anything in its"},{"type":"text","text":" "},{"type":"text","text":"prolog and epilog. Wrap a bare "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode"},{"type":"text","text":" in "},{"type":"codeVoice","code":"XMLDocument(root:)"},{"type":"text","text":" to format"},{"type":"text","text":" "},{"type":"text","text":"an XML node tree with no such surroundings."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode"},{"type":"text","text":" tree records namespace "},{"type":"emphasis","inlineContent":[{"text":"URIs","type":"text"}]},{"type":"text","text":", never prefixes, so the"},{"type":"text","text":" "},{"type":"text","text":"prefixes are chosen here. Every namespace declaration is emitted on the root"},{"type":"text","text":" "},{"type":"text","text":"element, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct\/namespaces"},{"type":"text","text":" says what those declarations are. A URI"},{"type":"text","text":" "},{"type":"text","text":"left unmentioned is still written correctly: it becomes the default"},{"type":"text","text":" "},{"type":"text","text":"namespace if every element in the tree carries it, and otherwise receives a"},{"type":"text","text":" "},{"type":"text","text":"generated prefix. A document using a single namespace throughout therefore"},{"type":"text","text":" "},{"type":"text","text":"needs no configuration, and is written exactly as it would be by hand."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two consequences are worth stating plainly. An attribute in a namespace is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"always","type":"text"}]},{"type":"text","text":" written with a prefix, even when its URI is also the default"},{"type":"text","text":" "},{"type":"text","text":"namespace, because an unprefixed attribute name is in no namespace at all."},{"type":"text","text":" "},{"type":"text","text":"And a namespace declaration cannot be written as an ordinary attribute: any"},{"type":"text","text":" "},{"type":"text","text":"attribute name beginning with "},{"type":"codeVoice","code":"xmlns"},{"type":"text","text":" is rejected as reserved."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that a document using more than one namespace does not survive a parse"},{"type":"text","text":" "},{"type":"text","text":"and reformat byte for byte, since the prefixes it is written with are chosen"},{"type":"text","text":" "},{"type":"text","text":"rather than recovered. What survives is meaning — every name resolves to the"},{"type":"text","text":" "},{"type":"text","text":"namespace it resolved to before — and formatting is idempotent thereafter."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An emitted XML declaration is always a complete one, naming a version, an"},{"type":"text","text":" "},{"type":"text","text":"encoding, and whether the document is standalone, whatever the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLDeclaration"},{"type":"text","text":" being formatted left out. Each omission has a value the"},{"type":"text","text":" "},{"type":"text","text":"XML specification assumes on a reader’s behalf — UTF-8 for an unnamed"},{"type":"text","text":" "},{"type":"text","text":"encoding, "},{"type":"codeVoice","code":"no"},{"type":"text","text":" for an absent "},{"type":"codeVoice","code":"standalone"},{"type":"text","text":" — so writing them out states what"},{"type":"text","text":" "},{"type":"text","text":"the document already meant, and leaves nothing about how it is to be read"},{"type":"text","text":" "},{"type":"text","text":"resting on a default the reader has to know. A declaration that named only a"},{"type":"text","text":" "},{"type":"text","text":"version therefore does not come back byte for byte, though it comes back"},{"type":"text","text":" "},{"type":"text","text":"saying the same thing, and formatting is idempotent thereafter."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The bytes produced are in the character encoding named by the XML"},{"type":"text","text":" "},{"type":"text","text":"declaration that is emitted, since that declaration is all a reader has to go"},{"type":"text","text":" "},{"type":"text","text":"by. A document is therefore written in UTF-8 unless its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLDocument"},{"type":"text","text":" "},{"type":"text","text":"carries an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLDeclaration"},{"type":"text","text":" naming some other encoding "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct\/emitsXMLDeclaration"},{"type":"text","text":" is enabled — bytes nobody can decode are of"},{"type":"text","text":" "},{"type":"text","text":"no use to anyone, so suppressing the declaration also suppresses the choice"},{"type":"text","text":" "},{"type":"text","text":"of encoding. The encoding must be one the system knows by the IANA charset"},{"type":"text","text":" "},{"type":"text","text":"name the declaration spells it with, and it must be one an XML parser can be"},{"type":"text","text":" "},{"type":"text","text":"expected to read back, which rules out the UTF-32 family."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An encoding narrower than Unicode need not be able to carry every character"},{"type":"text","text":" "},{"type":"text","text":"in the document. In text and attribute values, one it cannot carry is written"},{"type":"text","text":" "},{"type":"text","text":"as a numeric character reference — "},{"type":"codeVoice","code":"caf&#xe9;"},{"type":"text","text":" in US-ASCII — which a parser"},{"type":"text","text":" "},{"type":"text","text":"reads back as the character itself, so the document survives an encoding that"},{"type":"text","text":" "},{"type":"text","text":"has never heard of it. Everywhere else, it does not: a reference is markup,"},{"type":"text","text":" "},{"type":"text","text":"and inside an element name, a comment, or a processing instruction it would"},{"type":"text","text":" "},{"type":"text","text":"be read as the literal characters that spell it. A name or a comment the"},{"type":"text","text":" "},{"type":"text","text":"encoding cannot carry is therefore an error rather than an approximation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Attributes are always emitted in ascending order by name and namespace URI,"},{"type":"text","text":" "},{"type":"text","text":"so formatting the same XML node tree twice always produces identical"},{"type":"text","text":" "},{"type":"text","text":"results."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"XMLFormatter"},{"type":"text","text":" instance is immutable and may be used to format any number"},{"type":"text","text":" "},{"type":"text","text":"of XML node trees concurrently."}]}]}],"metadata":{"modules":[{"name":"XestiXML"}],"externalID":"s:8XestiXML12XMLFormatterV","role":"symbol","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"XMLFormatter"}],"symbolKind":"struct","title":"XMLFormatter","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"XMLFormatter","kind":"identifier"}]},"sections":[],"kind":"symbol","references":{"doc://XestiXML/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/XestiXML\/s8SendableP"},"doc://XestiXML/documentation/XestiXML/XMLFormatter":{"kind":"symbol","url":"\/documentation\/xestixml\/xmlformatter","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"XMLFormatter","kind":"identifier"}],"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter","navigatorTitle":[{"text":"XMLFormatter","kind":"identifier"}],"type":"topic","abstract":[{"text":"A simplified XML formatter.","type":"text"}],"title":"XMLFormatter"},"doc://XestiXML/documentation/XestiXML/XMLElement":{"abstract":[{"text":"A type-safe XML element.","type":"text"}],"url":"\/documentation\/xestixml\/xmlelement","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"XMLElement","kind":"identifier"}],"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLElement","navigatorTitle":[{"text":"XMLElement","kind":"identifier"}],"kind":"symbol","type":"topic","title":"XMLElement"},"doc://XestiXML/documentation/XestiXML/XMLNode":{"role":"symbol","type":"topic","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode","kind":"symbol","title":"XMLNode","abstract":[{"type":"text","text":"A node in the abstract, logical tree structure that represents an XML"},{"type":"text","text":" "},{"type":"text","text":"document."}],"navigatorTitle":[{"text":"XMLNode","kind":"identifier"}],"url":"\/documentation\/xestixml\/xmlnode","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"XMLNode","kind":"identifier"}]},"doc://XestiXML/documentation/XestiXML/XMLFormatter/init(options:)":{"role":"symbol","url":"\/documentation\/xestixml\/xmlformatter\/init(options:)","kind":"symbol","title":"init(options:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"options"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8XestiXML12XMLFormatterV7OptionsV","kind":"typeIdentifier","text":"Options"},{"kind":"text","text":")"}],"type":"topic","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/init(options:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"XMLFormatter","type":"codeVoice"},{"type":"text","text":" instance."}]},"doc://XestiXML/documentation/XestiXML/XMLDocument":{"type":"topic","abstract":[{"type":"text","text":"An entire XML document: a root element, together with everything that"},{"type":"text","text":" "},{"type":"text","text":"surrounds it."}],"role":"symbol","title":"XMLDocument","url":"\/documentation\/xestixml\/xmldocument","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"XMLDocument"}],"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLDocument","navigatorTitle":[{"kind":"identifier","text":"XMLDocument"}]},"doc://XestiXML/documentation/XestiXML/XMLFormatter/Options-swift.struct/emitsXMLDeclaration":{"abstract":[{"type":"text","text":"A Boolean value indicating whether the formatted XML document is"},{"type":"text","text":" "},{"type":"text","text":"preceded by an XML declaration."}],"url":"\/documentation\/xestixml\/xmlformatter\/options-swift.struct\/emitsxmldeclaration","role":"symbol","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct\/emitsXMLDeclaration","title":"emitsXMLDeclaration","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"emitsXMLDeclaration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol"},"doc://XestiXML/documentation/XestiXML/XMLFormatter/options-swift.property":{"abstract":[{"type":"text","text":"The options that control how an XML document is formatted."}],"url":"\/documentation\/xestixml\/xmlformatter\/options-swift.property","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/options-swift.property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"options"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8XestiXML12XMLFormatterV7OptionsV","kind":"typeIdentifier","text":"Options"}],"type":"topic","kind":"symbol","role":"symbol","title":"options"},"doc://XestiXML/documentation/XestiXML/XMLAttribute":{"abstract":[{"type":"tex