on","type":"topic","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML","kind":"symbol","title":"XestiXML","abstract":[{"text":"XML tools.","type":"text"}],"url":"\/documentation\/xestixml"},"doc://XestiXML/documentation/XestiXML/XMLFormatter/Options-swift.struct/stripsComments":{"kind":"symbol","url":"\/documentation\/xestixml\/xmlformatter\/options-swift.struct\/stripscomments","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"stripsComments"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Options-swift.struct\/stripsComments","type":"topic","abstract":[{"text":"A Boolean value indicating whether comments are omitted from the","type":"text"},{"text":" ","type":"text"},{"text":"formatted XML document.","type":"text"}],"title":"stripsComments"},"doc://XestiXML/documentation/XestiXML/XMLParser":{"role":"symbol","type":"topic","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser","kind":"symbol","title":"XMLParser","abstract":[{"text":"A simplified XML parser.","type":"text"}],"navigatorTitle":[{"text":"XMLParser","kind":"identifier"}],"url":"\/documentation\/xestixml\/xmlparser","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"XMLParser","kind":"identifier"}]},"doc://XestiXML/documentation/XestiXML/XMLDeclaration":{"type":"topic","abstract":[{"type":"text","text":"The XML declaration at the head of an XML document."}],"role":"symbol","title":"XMLDeclaration","url":"\/documentation\/xestixml\/xmldeclaration","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"XMLDeclaration"}],"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLDeclaration","navigatorTitle":[{"kind":"identifier","text":"XMLDeclaration"}]},"doc://XestiXML/documentation/XestiXML/XMLFormatter/Namespace":{"title":"XMLFormatter.Namespace","url":"\/documentation\/xestixml\/xmlformatter\/namespace","role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"E","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"XMLElement","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"A","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"XMLAttribute","type":"codeVoice"},{"text":".","type":"text"}]},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Namespace","kind":"identifier"}],"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter\/Namespace","navigatorTitle":[{"text":"Namespace","kind":"identifier"}],"abstract":[{"text":"A binding of a namespace prefix to a namespace URI.","type":"text"}],"kind":"symbol","type":"topic"}}}