{"seeAlsoSections":[{"generated":true,"title":"Parsing and formatting","anchor":"Parsing-and-formatting","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter"]}],"metadata":{"title":"XMLParser","navigatorTitle":[{"text":"XMLParser","kind":"identifier"}],"role":"symbol","modules":[{"name":"XestiXML"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"XMLParser","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:8XestiXML9XMLParserV","symbolKind":"struct"},"hierarchy":{"paths":[["doc:\/\/XestiXML\/documentation\/XestiXML"]]},"abstract":[{"text":"A simplified XML parser.","type":"text"}],"topicSections":[{"generated":true,"anchor":"Structures","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Options-swift.struct"],"title":"Structures"},{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/init(options:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/options-swift.property"]},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/parse(_:)"],"title":"Instance Methods"},{"generated":true,"title":"Enumerations","anchor":"Enumerations","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Error"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"XMLParser","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"A","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLElement","kind":"typeIdentifier","text":"XMLElement","preciseIdentifier":"s:8XestiXML10XMLElementP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"A"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute","kind":"typeIdentifier","text":"XMLAttribute","preciseIdentifier":"s:8XestiXML12XMLAttributeP"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"code":"XMLParser","type":"codeVoice"},{"text":" drives the SAX2 interface of ","type":"text"},{"code":"libxml2","type":"codeVoice"},{"text":" and hides all the","type":"text"},{"text":" ","type":"text"},{"text":"machinery needed to build a type-safe tree of ","type":"text"},{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode","type":"reference","isActive":true},{"text":" instances","type":"text"},{"text":" ","type":"text"},{"text":"representing the parsed XML document source. Essentially, ","type":"text"},{"code":"XMLParser","type":"codeVoice"},{"text":" ","type":"text"},{"text":"converts an XML document into a very simple “DOM”. It is ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"simple","type":"text"}]},{"text":" in that","type":"text"},{"text":" ","type":"text"},{"text":"only elements, with any associated attributes, text, comments, and","type":"text"},{"text":" ","type":"text"},{"text":"processing instructions are represented in the resulting tree. CDATA blocks","type":"text"},{"text":" ","type":"text"},{"text":"are converted to text.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Whitespace in character data is normalized — leading and trailing whitespace","type":"text"},{"text":" ","type":"text"},{"text":"is stripped, runs of whitespace are collapsed to a single space, and a run of","type":"text"},{"text":" ","type":"text"},{"text":"nothing but whitespace is discarded entirely — ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"unless","type":"text"}]},{"text":" the enclosing element","type":"text"},{"text":" ","type":"text"},{"text":"is under ","type":"text"},{"code":"xml:space=\"preserve\"","type":"codeVoice"},{"text":", in which case the text is taken exactly as","type":"text"},{"text":" ","type":"text"},{"text":"written. Preservation is inherited by descendants until a descendant asks for","type":"text"},{"text":" ","type":"text"},{"code":"xml:space=\"default\"","type":"codeVoice"},{"text":", and it means that a run of nothing but whitespace","type":"text"},{"text":" ","type":"text"},{"text":"becomes a text node of its own rather than vanishing. An ","type":"text"},{"code":"xml:space","type":"codeVoice"},{"text":" value","type":"text"},{"text":" ","type":"text"},{"text":"other than these two is not valid XML; it is ignored rather than rejected,","type":"text"},{"text":" ","type":"text"},{"text":"exactly as if the attribute were absent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Note that the typed accessors in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode","type":"reference"},{"text":" normalize whitespace when","type":"text"},{"text":" ","type":"text"},{"text":"extracting a value, whether or not it was preserved. Preserved text is","type":"text"},{"text":" ","type":"text"},{"text":"visible through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode\/value","type":"reference"},{"text":" and through the text nodes themselves.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Elements and attributes are mapped to custom ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLElement","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute","type":"reference"},{"text":" types, respectively.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each comment and processing instruction becomes an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode","type":"reference"},{"text":" of its own","type":"text"},{"text":" ","type":"text"},{"text":"unless ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Options-swift.struct\/stripsComments","type":"reference"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Options-swift.struct\/stripsProcessingInstructions","type":"reference"},{"text":" is enabled, in which case it is","type":"text"},{"text":" ","type":"text"},{"text":"ignored. Neither is character data, so neither contributes to the value of","type":"text"},{"text":" ","type":"text"},{"text":"the element containing it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Parsing yields an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLDocument","type":"reference"},{"text":", which carries everything that surrounds","type":"text"},{"text":" ","type":"text"},{"text":"the root element — the XML declaration, the document type declaration, and","type":"text"},{"text":" ","type":"text"},{"text":"any comments and processing instructions in the prolog and epilog:","type":"text"}],"type":"paragraph"},{"code":["let document = try XMLParser<E, A>().parse(data)","","document.root       \/\/ the XML node tree alone"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The declarations ","type":"text"},{"inlineContent":[{"text":"within","type":"text"}],"type":"emphasis"},{"text":" the internal subset of a document type declaration","type":"text"},{"text":" ","type":"text"},{"text":"are always ignored, as are any comments and processing instructions","type":"text"},{"text":" ","type":"text"},{"text":"appearing among them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"External content is ","type":"text"},{"inlineContent":[{"text":"never","type":"text"}],"type":"emphasis"},{"text":" fetched. External DTD subsets and external","type":"text"},{"text":" ","type":"text"},{"text":"entities are not loaded from the network or from the file system, so a","type":"text"},{"text":" ","type":"text"},{"text":"reference to an entity declared ","type":"text"},{"code":"SYSTEM","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"PUBLIC","type":"codeVoice"},{"text":" is reported as an","type":"text"},{"text":" ","type":"text"},{"text":"undefined-entity parse error rather than resolved. Entity expansion limits","type":"text"},{"text":" ","type":"text"},{"text":"are left at their defaults, so exponential-expansion (“billion laughs”)","type":"text"},{"text":" ","type":"text"},{"text":"documents fail with an error instead of exhausting memory.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Elements and attributes alike are reported as a local name accompanied by a","type":"text"},{"text":" ","type":"text"},{"text":"namespace URI; the prefix a name was written with is discarded, since it is","type":"text"},{"text":" ","type":"text"},{"text":"a lexical accident of the source rather than part of the name’s identity.","type":"text"},{"text":" ","type":"text"},{"text":"Two attributes therefore remain distinct when they share a local name but","type":"text"},{"text":" ","type":"text"},{"text":"differ in namespace, and a namespace declaration is never reported as an","type":"text"},{"text":" ","type":"text"},{"text":"attribute. Note that an unprefixed attribute name is in ","type":"text"},{"inlineContent":[{"text":"no","type":"text"}],"type":"emphasis"},{"text":" namespace, and","type":"text"},{"text":" ","type":"text"},{"text":"so is reported with a ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" URI even when the enclosing element declares a","type":"text"},{"text":" ","type":"text"},{"text":"default namespace — which is what the Namespaces in XML specification","type":"text"},{"text":" ","type":"text"},{"text":"requires.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Attributes given a default value by an ","type":"text"},{"code":"<!ATTLIST>","type":"codeVoice"},{"text":" declaration in the","type":"text"},{"text":" ","type":"text"},{"text":"internal subset are reported exactly as if they had appeared explicitly in","type":"text"},{"text":" ","type":"text"},{"text":"the document. This is deliberate: XML requires such an attribute to be","type":"text"},{"text":" ","type":"text"},{"text":"supplied, so it is genuinely part of the document, and discarding it would","type":"text"},{"text":" ","type":"text"},{"text":"silently yield ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for a value the document actually carries. The","type":"text"},{"text":" ","type":"text"},{"text":"consequence is that an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute","type":"reference"},{"text":" type must recognize every defaulted","type":"text"},{"text":" ","type":"text"},{"text":"attribute name as well as every written one; otherwise parsing fails with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Error\/unrecognizedAttribute(_:_:_:)","type":"reference"},{"text":" naming an attribute that appears","type":"text"},{"text":" ","type":"text"},{"text":"nowhere in the document source. Adding that name to the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute","type":"reference"},{"text":" ","type":"text"},{"text":"type resolves it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Note that ","type":"text"},{"code":"XMLParser","type":"codeVoice"},{"text":" has a few remaining limitations. These have been","type":"text"},{"text":" ","type":"text"},{"text":"verified empirically on macOS; the behavior may differ on other platforms.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"References to entities declared in an internal DTD subset are expanded in"},{"type":"text","text":" "},{"type":"text","text":"element content but "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" in attribute values. Given a declaration of"},{"type":"text","text":" "},{"type":"codeVoice","code":"<!ENTITY e \"value\">"},{"type":"text","text":", the text of "},{"type":"codeVoice","code":"<root>&e;<\/root>"},{"type":"text","text":" is "},{"type":"codeVoice","code":"value"},{"type":"text","text":", but the"},{"type":"text","text":" "},{"type":"text","text":"attribute value of "},{"type":"codeVoice","code":"<root name=\"&e;\"\/>"},{"type":"text","text":" is the literal string "},{"type":"codeVoice","code":"&e;"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Predefined entities (such as "},{"type":"codeVoice","code":"&amp;"},{"type":"text","text":") and numeric character references"},{"type":"text","text":" "},{"type":"text","text":"(such as "},{"type":"codeVoice","code":"&#65;"},{"type":"text","text":") are resolved normally in both positions."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"XML 1.1 is not supported. A document declaring any version other than"},{"type":"text","text":" "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" is parsed as if it had declared "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":", so neither the additional"},{"type":"text","text":" "},{"type":"text","text":"name characters nor the extra line-ending normalization of XML 1.1 is"},{"type":"text","text":" "},{"type":"text","text":"honored. A declared version outside the "},{"type":"codeVoice","code":"1.x"},{"type":"text","text":" range fails with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Error\/parseFailure(_:_:_:)"},{"type":"text","text":"."}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/xestixml\/xmlparser"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://XestiXML/documentation/XestiXML/XMLParser/options-swift.property":{"title":"options","kind":"symbol","type":"topic","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/options-swift.property","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"options"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8XestiXML9XMLParserV7OptionsV","text":"Options"}],"url":"\/documentation\/xestixml\/xmlparser\/options-swift.property","abstract":[{"text":"The options that control how an XML document is parsed.","type":"text"}]},"doc://XestiXML/documentation/XestiXML/XMLElement":{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLElement","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"XMLElement","kind":"identifier"}],"abstract":[{"type":"text","text":"A type-safe XML element."}],"url":"\/documentation\/xestixml\/xmlelement","title":"XMLElement","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"XMLElement","kind":"identifier"}]},"doc://XestiXML/documentation/XestiXML/XMLAttribute":{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute","url":"\/documentation\/xestixml\/xmlattribute","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"XMLAttribute"}],"t