nd":"symbol","role":"symbol","title":"XMLParser.Error.parseFailure(_:_:_:)"},"doc://XestiXML/documentation/XestiXML/XMLParser/options-swift.property":{"abstract":[{"type":"text","text":"The options that control how an XML document is parsed."}],"url":"\/documentation\/xestixml\/xmlparser\/options-swift.property","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"options"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8XestiXML9XMLParserV7OptionsV","text":"Options"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/options-swift.property","title":"options"},"doc://XestiXML/documentation/XestiXML/XMLAttribute":{"abstract":[{"type":"text","text":"A type-safe XML attribute."}],"url":"\/documentation\/xestixml\/xmlattribute","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute","navigatorTitle":[{"kind":"identifier","text":"XMLAttribute"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"XMLAttribute"}],"type":"topic","kind":"symbol","role":"symbol","title":"XMLAttribute"},"doc://XestiXML/documentation/XestiXML/XMLParser/Options-swift.struct/stripsComments":{"type":"topic","abstract":[{"type":"text","text":"A Boolean value indicating whether comments are discarded rather than"},{"type":"text","text":" "},{"type":"text","text":"represented in the parsed XML document."}],"role":"symbol","url":"\/documentation\/xestixml\/xmlparser\/options-swift.struct\/stripscomments","title":"stripsComments","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"stripsComments"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Options-swift.struct\/stripsComments"},"doc://XestiXML/documentation/XestiXML/XMLNode/value":{"title":"value","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode\/value","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"E","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"XMLElement","type":"codeVoice"},{"type":"text","text":" and "},{"code":"A","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"XMLAttribute","type":"codeVoice"},{"type":"text","text":"."}]},"abstract":[{"type":"text","text":"The concatenation of the string values of all descendant text nodes of"},{"type":"text","text":" "},{"type":"text","text":"this node, or the string value itself, if this node is a text node;"},{"type":"text","text":" "},{"type":"text","text":"otherwise, "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/xestixml\/xmlnode\/value","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://XestiXML/documentation/XestiXML/XMLParser":{"role":"symbol","type":"topic","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser","kind":"symbol","title":"XMLParser","abstract":[{"text":"A simplified XML parser.","type":"text"}],"navigatorTitle":[{"text":"XMLParser","kind":"identifier"}],"url":"\/documentation\/xestixml\/xmlparser","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"XMLParser","kind":"identifier"}]},"doc://XestiXML/documentation/XestiXML":{"role":"collection","type":"topic","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML","kind":"symbol","title":"XestiXML","abstract":[{"text":"XML tools.","type":"text"}],"url":"\/documentation\/xestixml"}}}