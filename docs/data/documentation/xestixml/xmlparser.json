er comments are discarded rather than"},{"type":"text","text":" "},{"type":"text","text":"represented in the parsed XML document."}],"kind":"symbol","url":"\/documentation\/xestixml\/xmlparser\/options-swift.struct\/stripscomments","role":"symbol","type":"topic","title":"stripsComments","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Options-swift.struct\/stripsComments"},"doc://XestiXML/documentation/XestiXML/XMLParser/parse(_:)":{"type":"topic","role":"symbol","title":"parse(_:)","url":"\/documentation\/xestixml\/xmlparser\/parse(_:)","abstract":[{"type":"text","text":"Parses the provided XML document."}],"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"parse"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV","text":"Data"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:8XestiXML9XMLParserV5ErrorO","text":"Error"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:8XestiXML11XMLDocumentV","kind":"typeIdentifier","text":"XMLDocument"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:8XestiXML9XMLParserV1Exmfp","kind":"typeIdentifier","text":"E"},{"kind":"text","text":", "},{"preciseIdentifier":"s:8XestiXML9XMLParserV1Aq_mfp","kind":"typeIdentifier","text":"A"},{"kind":"text","text":">"}],"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/parse(_:)","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"E"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"XMLElement"},{"type":"text","text":" and "},{"type":"codeVoice","code":"A"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"XMLAttribute"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"kind":"symbol"}}}