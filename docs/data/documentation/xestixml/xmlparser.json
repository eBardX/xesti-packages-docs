{"metadata":{"roleHeading":"Structure","symbolKind":"struct","externalID":"s:8XestiXML9XMLParserV","navigatorTitle":[{"kind":"identifier","text":"XMLParser"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"XMLParser"}],"title":"XMLParser","modules":[{"name":"XestiXML"}]},"abstract":[{"type":"text","text":"A simplified XML parser."}],"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Options-swift.struct"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/init(options:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/options-swift.property"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/parse(_:)"]},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Error"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"XMLParser"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"A"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:8XestiXML10XMLElementP","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLElement","text":"XMLElement"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"A"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:8XestiXML12XMLAttributeP","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute","text":"XMLAttribute"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"code":"XMLParser","type":"codeVoice"},{"type":"text","text":" drives the SAX2 interface of "},{"code":"libxml2","type":"codeVoice"},{"type":"text","text":" and hides all the"},{"type":"text","text":" "},{"type":"text","text":"machinery needed to build a type-safe tree of "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode","isActive":true},{"type":"text","text":" instances"},{"type":"text","text":" "},{"type":"text","text":"representing the parsed XML document source. Essentially, "},{"code":"XMLParser","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"converts an XML document into a very simple “DOM”. It is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"simple"}]},{"type":"text","text":" in that"},{"type":"text","text":" "},{"type":"text","text":"only elements, with any associated attributes, text, comments, and"},{"type":"text","text":" "},{"type":"text","text":"processing instructions are represented in the resulting tree. CDATA blocks"},{"type":"text","text":" "},{"type":"text","text":"are converted to text."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Whitespace in character data is normalized — leading and trailing whitespace"},{"type":"text","text":" "},{"type":"text","text":"is stripped, runs of whitespace are collapsed to a single space, and a run of"},{"type":"text","text":" "},{"type":"text","text":"nothing but whitespace is discarded entirely — "},{"type":"emphasis","inlineContent":[{"type":"text","text":"unless"}]},{"type":"text","text":" the enclosing element"},{"type":"text","text":" "},{"type":"text","text":"is under "},{"code":"xml:space=\"preserve\"","type":"codeVoice"},{"type":"text","text":", in which case the text is taken exactly as"},{"type":"text","text":" "},{"type":"text","text":"written. Preservation is inherited by descendants until a descendant asks for"},{"type":"text","text":" "},{"code":"xml:space=\"default\"","type":"codeVoice"},{"type":"text","text":", and it means that a run of nothing but whitespace"},{"type":"text","text":" "},{"type":"text","text":"becomes a text node of its own rather than vanishing. An "},{"code":"xml:space","type":"codeVoice"},{"type":"text","text":" value"},{"type":"text","text":" "},{"type":"text","text":"other than these two is not valid XML; it is ignored rather than rejected,"},{"type":"text","text":" "},{"type":"text","text":"exactly as if the attribute were absent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note that the typed accessors in "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode","isActive":true},{"type":"text","text":" normalize whitespace when"},{"type":"text","text":" "},{"type":"text","text":"extracting a value, whether or not it was preserved. Preserved text is"},{"type":"text","text":" "},{"type":"text","text":"visible through "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode\/value","isActive":true},{"type":"text","text":" and through the text nodes themselves."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Elements and attributes are mapped to custom "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLElement","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute","isActive":true},{"type":"text","text":" types, respectively."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each comment and processing instruction becomes an "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLNode","isActive":true},{"type":"text","text":" of its own"},{"type":"text","text":" "},{"type":"text","text":"unless "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Options-swift.struct\/stripsComments","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Options-swift.struct\/stripsProcessingInstructions","isActive":true},{"type":"text","text":" is enabled, in which case it is"},{"type":"text","text":" "},{"type":"text","text":"ignored. Neither is character data, so neither contributes to the value of"},{"type":"text","text":" "},{"type":"text","text":"the element containing it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Parsing yields an "},{"type":"reference","identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLDocument","isActive":true},{"type":"text","text":", which carries everything that surrounds"},{"type":"text","text":" "},{"type":"text","text":"the root element — the XML declaration, the document type declaration, and"},{"type":"text","text":" "},{"type":"text","text":"any comments and processing instructions in the prolog and epilog:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let document = try XMLParser<E, A>().parse(data)","","document.root       \/\/ the XML node tree alone"]},{"inlineContent":[{"type":"text","text":"The declarations "},{"type":"emphasis","inlineContent":[{"type":"text","text":"within"}]},{"type":"text","text":" the internal subset of a document type declaration"},{"type":"text","text":" "},{"type":"text","text":"are always ignored, as are any comments and processing instructions"},{"type":"text","text":" "},{"type":"text","text":"appearing among them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"External content is "},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"type":"text","text":" fetched. External DTD subsets and external"},{"type":"text","text":" "},{"type":"text","text":"entities are not loaded from the network or from the file system, so a"},{"type":"text","text":" "},{"type":"text","text":"reference to an entity declared "},{"code":"SYSTEM","type":"codeVoice"},{"type":"text","text":" or "},{"code":"PUBLIC","type":"codeVoice"},{"type":"text","text":" is reported as an"},{"type":"text","text":" "},{"type":"text","text":"undefined-entity parse error rather than resolved. Entity expansion limits"},{"type":"text","text":" "},{"type":"text","text":"are left at their defaults, so exponential-expansion (“billion laughs”)"},{"type":"text","text":" "},{"type":"text","text":"documents fail with an error instead of exhausting memory."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Elements and attributes alike are reported as a local name accompanied by a"},{"type":"text","text":" "},{"type":"text","text":"namespace URI; the prefix a name was written with is discarded, since it is"},{"type":"text","text":" "},{"type":"text","text":"a lexical accident of the source rather than part of the name’s identity."},{"type":"text","text":" "},{"type":"text","text":"Two attributes therefore remain distinct when they share a local name but"},{"type":"text","text":" "},{"type":"text","text":"differ in namespace, and a namespace declaration is never reported as an"},{"type":"text","text":" "},{"type":"text","text":"attribute. Note that an unprefixed attribute name is in "},{"inlineContent":[{"type":"text","text":"no"}],"type":"emphasis"},{"type":"text","text":" namespace, and"},{"type":"text","text":" "},{"type":"text","text":"so is reported with a "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" URI even when the enclosing element declares a"},{"type":"text","text":" "},{"type":"text","text":"default namespace — which is what the Namespaces in XML specification"},{"type":"text","text":" "},{"type":"text","text":"requires."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Attributes given a default value by an "},{"code":"<!ATTLIST>","type":"codeVoice"},{"type":"text","text":" declaration in the"},{"type":"text","text":" "},{"type":"text","text":"internal subset are reported exactly as if they had appeared explicitly in"},{"type":"text","text":" "},{"type":"text","text":"the document. This is deliberate: XML requires such an attribute to be"},{"type":"text","text":" "},{"type":"text","text":"supplied, so it is genuinely part of the document, and discarding it would"},{"type":"text","text":" "},{"type":"text","text":"silently yield "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for a value the document actually carries. The"},{"type":"text","text":" "},{"type":"text","text":"consequence is that an "},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute","type":"reference"},{"text":" type must recognize every defaulted","type":"text"},{"text":" ","type":"text"},{"text":"attribute name as well as every written one; otherwise parsing fails with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Error\/unrecognizedAttribute(_:_:_:)","type":"reference","isActive":true},{"type":"text","text":" naming an attribute that appears"},{"text":" ","type":"text"},{"text":"nowhere in the document source. Adding that name to the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLAttribute","type":"reference"},{"text":" ","type":"text"},{"text":"type resolves it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Note that ","type":"text"},{"code":"XMLParser","type":"codeVoice"},{"text":" has a few remaining limitations. These have been","type":"text"},{"text":" ","type":"text"},{"text":"verified empirically on macOS; the behavior may differ on other platforms.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"References to entities declared in an internal DTD subset are expanded in"},{"type":"text","text":" "},{"type":"text","text":"element content but "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" in attribute values. Given a declaration of"},{"type":"text","text":" "},{"code":"<!ENTITY e \"value\">","type":"codeVoice"},{"text":", the text of ","type":"text"},{"type":"codeVoice","code":"<root>&e;<\/root>"},{"type":"text","text":" is "},{"type":"codeVoice","code":"value"},{"text":", but the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"attribute value of "},{"code":"<root name=\"&e;\"\/>","type":"codeVoice"},{"type":"text","text":" is the literal string "},{"type":"codeVoice","code":"&e;"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Predefined entities (such as ","type":"text"},{"code":"&amp;","type":"codeVoice"},{"text":") and numeric character references","type":"text"},{"text":" ","type":"text"},{"text":"(such as ","type":"text"},{"code":"&#65;","type":"codeVoice"},{"text":") are resolved normally in both positions.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"XML 1.1 is not supported. A document declaring any version other than","type":"text"},{"type":"text","text":" "},{"code":"1.0","type":"codeVoice"},{"text":" is parsed as if it had declared ","type":"text"},{"code":"1.0","type":"codeVoice"},{"type":"text","text":", so neither the additional"},{"type":"text","text":" "},{"type":"text","text":"name characters nor the extra line-ending normalization of XML 1.1 is"},{"type":"text","text":" "},{"text":"honored. A declared version outside the ","type":"text"},{"code":"1.x","type":"codeVoice"},{"text":" range fails with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Error\/parseFailure(_:_:_:)","type":"reference"},{"type":"text","text":"."}]}]}],"type":"unorderedList"}],"kind":"content"}],"seeAlsoSections":[{"title":"Parsing and formatting","generated":true,"anchor":"Parsing-and-formatting","identifiers":["doc:\/\/XestiXML\/documentation\/XestiXML\/XMLFormatter"]}],"sections":[],"variants":[{"paths":["\/documentation\/xestixml\/xmlparser"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/XestiXML\/documentation\/XestiXML"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://XestiXML/documentation/XestiXML/XMLParser/Options-swift.struct/stripsProcessingInstructions":{"type":"topic","abstract":[{"text":"A Boolean value indicating whether processing instructions are","type":"text"},{"text":" ","type":"text"},{"text":"discarded rather than represented in the parsed XML document.","type":"text"}],"role":"symbol","url":"\/documentation\/xestixml\/xmlparser\/options-swift.struct\/stripsprocessinginstructions","title":"stripsProcessingInstructions","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"stripsProcessingInstructions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLParser\/Options-swift.struct\/stripsProcessingInstructions"},"doc://XestiXML/documentation/XestiXML/XMLElement":{"abstract":[{"text":"A type-safe XML element.","type":"text"}],"url":"\/documentation\/xestixml\/xmlelement","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"XMLElement","kind":"identifier"}],"identifier":"doc:\/\/XestiXML\/documentation\/XestiXML\/XMLElement","navigatorTitle":[{"text":"XMLElement","kind":"identifier"}],"kind":"symbol","type":"topic","title":"XMLElement"},"doc://XestiXML/documentation/XestiXML/XMLParser/Error":{"navigatorTitle":[{"kind":"identifier","text":"Error"}],