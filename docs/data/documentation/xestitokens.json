{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/xestitokens"]}],"hierarchy":{"paths":[[]]},"sections":[],"abstract":[{"type":"text","text":"A rules-based lexical tokenizer."}],"kind":"symbol","primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"The XestiTokens framework provides a highly configurable rules-based lexical","type":"text"},{"text":" ","type":"text"},{"text":"tokenizer written in Swift. You can use it to tokenize a wide variety of text","type":"text"},{"text":" ","type":"text"},{"text":"input.","type":"text"}],"type":"paragraph"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"“If you can tokenize it with ","type":"text"},{"code":"lex","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"flex","type":"codeVoice"},{"text":", you can tokenize it with","type":"text"},{"text":" ","type":"text"},{"text":"XestiTokens.”","type":"text"}]}],"style":"note"},{"inlineContent":[{"text":"Tokenizing revolves around a small pipeline:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","alignments":["left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Stage","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Input → Output","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Tokenize","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"[Tokenizer.Token]"}]}]],[[{"inlineContent":[{"type":"text","text":"Match"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/TokenMatcher","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Sequence<Tokenizer.Token>"},{"type":"text","text":" → parsed result"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer","type":"reference","isActive":true},{"text":" is configured with an array of ","type":"text"},{"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Rule","type":"reference","isActive":true},{"text":" values, each","type":"text"},{"text":" ","type":"text"},{"text":"pairing a regular expression with the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Disposition","type":"reference"},{"text":" — save as a","type":"text"},{"type":"text","text":" "},{"text":"token, or skip — to apply when it matches. Rules can also carry","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/StartCondition","type":"reference","isActive":true},{"text":"s, familiar to anyone who has used ","type":"text"},{"type":"codeVoice","code":"lex"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"flex"},{"text":", letting the same input character trigger different rules depending on","type":"text"},{"text":" ","type":"text"},{"text":"the tokenizer’s current mode; and an ","type":"text"},{"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Action","type":"reference","isActive":true},{"text":" closure, letting a","type":"text"},{"text":" ","type":"text"},{"text":"rule inspect or update contextual user information and decide its disposition","type":"text"},{"text":" ","type":"text"},{"text":"dynamically at match time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/TokenMatcher","type":"reference","isActive":true},{"text":" then walks the resulting token sequence one token at a","type":"text"},{"text":" ","type":"text"},{"text":"time, offering simple lookahead and consume operations — ","type":"text"},{"type":"codeVoice","code":"nextMatches"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"readIfMatches"},{"text":", ","type":"text"},{"type":"codeVoice","code":"readMustMatch"},{"text":", ","type":"text"},{"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/TokenMatcher\/failOnNext()","type":"reference","isActive":true},{"text":" — that a","type":"text"},{"text":" ","type":"text"},{"text":"hand-written recursive descent parser can build on directly.","type":"text"}],"type":"paragraph"},{"code":["import XestiTokens","","let integerKind: Tokenizer.Token.Kind = \"integer\"","let opKind: Tokenizer.Token.Kind = \"op\"","","let rules: [Tokenizer.Rule] = [Tokenizer.Rule(\/[0-9]+\/, integerKind),","                               Tokenizer.Rule(\/[-+*\\\/]\/, opKind),","                               Tokenizer.Rule(regex: \/\\s+\/,","                                              disposition: .skip(nil))]","let tokenizer = Tokenizer(rules: rules)","","let tokens = try tokenizer.tokenize(input: \"1 + 2 * 3\")","","var matcher = TokenMatcher(tokens)","","while matcher.hasMore {","    let token = try matcher.readMustMatch([integerKind, opKind])","","    print(token)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Whenever more than one rule matches at the current position, the rule"},{"type":"text","text":" "},{"type":"text","text":"matching the longest substring wins; ties are broken by the order in which the"},{"type":"text","text":" "},{"type":"text","text":"rules were provided to the tokenizer. Input that matches no rule fails"},{"type":"text","text":" "},{"type":"text","text":"tokenization with a descriptive "},{"isActive":true,"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Error","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"anchor":"Tokenizing","identifiers":["doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Rule","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Rule\/ID-swift.struct","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Disposition","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/StartCondition","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Action","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/UserInfoKey","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Error"],"title":"Tokenizing"},{"anchor":"Tokens","identifiers":["doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Token","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Token\/Kind-swift.struct"],"title":"Tokens"},{"anchor":"Matching","identifiers":["doc:\/\/XestiTokens\/documentation\/XestiTokens\/TokenMatcher","doc:\/\/XestiTokens\/documentation\/XestiTokens\/TokenMatcher\/Error"],"title":"Matching"}],"identifier":{"url":"doc:\/\/XestiTokens\/documentation\/XestiTokens","interfaceLanguage":"swift"},"metadata":{"title":"XestiTokens","role":"collection","symbolKind":"module","color":{"standardColorIdentifier":"blue"},"externalID":"XestiTokens","roleHeading":"Framework","modules":[{"name":"XestiTokens"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://XestiTokens/documentation/XestiTokens/Tokenizer/Disposition":{"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Disposition","role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Disposition","kind":"identifier"}],"url":"\/documentation\/xestitokens\/tokenizer\/disposition","abstract":[{"type":"text","text":"A type representing the disposition of a successful match during"},{"type":"text","text":" "},{"type":"text","