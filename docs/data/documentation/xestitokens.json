{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"XestiTokens"}],"symbolKind":"module","roleHeading":"Framework","title":"XestiTokens","externalID":"XestiTokens","color":{"standardColorIdentifier":"blue"},"role":"collection"},"identifier":{"url":"doc:\/\/XestiTokens\/documentation\/XestiTokens","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A rules-based lexical tokenizer."}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The XestiTokens framework provides a highly configurable rules-based lexical","type":"text"},{"text":" ","type":"text"},{"text":"tokenizer written in Swift. You can use it to tokenize a wide variety of text","type":"text"},{"text":" ","type":"text"},{"text":"input.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"inlineContent":[{"text":"“If you can tokenize it with ","type":"text"},{"type":"codeVoice","code":"lex"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"flex"},{"text":", you can tokenize it with","type":"text"},{"text":" ","type":"text"},{"text":"XestiTokens.”","type":"text"}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"text":"Tokenizing revolves around a small pipeline:","type":"text"}],"type":"paragraph"},{"alignments":["left","left","left"],"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Stage"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Input → Output"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tokenize"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"[Tokenizer.Token]"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Match","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/TokenMatcher"}]}],[{"type":"paragraph","inlineContent":[{"code":"Sequence<Tokenizer.Token>","type":"codeVoice"},{"text":" → parsed result","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer","isActive":true},{"type":"text","text":" is configured with an array of "},{"type":"reference","identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Rule","isActive":true},{"type":"text","text":" values, each"},{"type":"text","text":" "},{"type":"text","text":"pairing a regular expression with the "},{"type":"reference","identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Disposition","isActive":true},{"type":"text","text":" — save as a"},{"type":"text","text":" "},{"type":"text","text":"token, or skip — to apply when it matches. Rules can also carry"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/StartCondition","isActive":true},{"type":"text","text":"s, familiar to anyone who has used "},{"type":"codeVoice","code":"lex"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"flex","type":"codeVoice"},{"type":"text","text":", letting the same input character trigger different rules depending on"},{"type":"text","text":" "},{"type":"text","text":"the tokenizer’s current mode; and an "},{"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Action","type":"reference","isActive":true},{"type":"text","text":" closure, letting a"},{"type":"text","text":" "},{"type":"text","text":"rule inspect or update contextual user information and decide its disposition"},{"type":"text","text":" "},{"type":"text","text":"dynamically at match time."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/TokenMatcher"},{"text":" then walks the resulting token sequence one token at a","type":"text"},{"text":" ","type":"text"},{"text":"time, offering simple lookahead and consume operations — ","type":"text"},{"code":"nextMatches","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"readIfMatches","type":"codeVoice"},{"text":", ","type":"text"},{"code":"readMustMatch","type":"codeVoice"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/TokenMatcher\/failOnNext()"},{"text":" — that a","type":"text"},{"text":" ","type":"text"},{"text":"hand-written recursive descent parser can build on directly.","type":"text"}],"type":"paragraph"},{"code":["import XestiTokens","","let integerKind: Tokenizer.Token.Kind = \"integer\"","let opKind: Tokenizer.Token.Kind = \"op\"","","let rules: [Tokenizer.Rule] = [Tokenizer.Rule(\/[0-9]+\/, integerKind),","                               Tokenizer.Rule(\/[-+*\\\/]\/, opKind),","                               Tokenizer.Rule(regex: \/\\s+\/,","                                              disposition: .skip(nil))]","let tokenizer = Tokenizer(rules: rules)","","let tokens = try tokenizer.tokenize(input: \"1 + 2 * 3\")","","var matcher = TokenMatcher(tokens)","","while matcher.hasMore {","    let token = try matcher.readMustMatch([integerKind, opKind])","","    print(token)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Whenever more than one rule matches at the current position, the rule"},{"type":"text","text":" "},{"type":"text","text":"matching the longest substring wins; ties are broken by the order in which the"},{"type":"text","text":" "},{"type":"text","text":"rules were provided to the tokenizer. Input that matches no rule fails"},{"type":"text","text":" "},{"type":"text","text":"tokenization with a descriptive "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Error"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/xestitokens"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Rule","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Rule\/ID-swift.struct","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Disposition","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/StartCondition","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Action","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/UserInfoKey","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Error"],"anchor":"Tokenizing","title":"Tokenizing"},{"identifiers":["doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Token","doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Token\/Kind-swift.struct"],"anchor":"Tokens","title":"Tokens"},{"identifiers":["doc:\/\/XestiTokens\/documentation\/XestiTokens\/TokenMatcher","doc:\/\/XestiTokens\/documentation\/XestiTokens\/TokenMatcher\/Error"],"anchor":"Matching","title":"Matching"}],"references":{"doc://XestiTokens/documentation/XestiTokens/Tokenizer/Rule/ID-swift.struct":{"kind":"symbol","url":"\/documentation\/xestitokens\/tokenizer\/rule\/id-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ID"}],"role":"symbol","abstract":[{"text":"A type representing the stable identity of a tokenizer rule.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ID"}],"title":"Toke