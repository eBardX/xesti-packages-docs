l as its location in the input string."}],"kind":"symbol","identifier":"doc:\/\/XestiTokens\/documentation\/XestiTokens\/Tokenizer\/Token","navigatorTitle":[{"kind":"identifier","text":"Token"}],"type":"topic"}}}