{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/XestiNumbers\/documentation\/XestiNumbers","doc:\/\/XestiNumbers\/documentation\/XestiNumbers\/Number"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/xestinumbers\/number\/simplified"]}],"metadata":{"roleHeading":"Instance Property","extendedModule":"XestiNumbers","title":"simplified","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"simplified"},{"kind":"text","text":": `Self`"}],"role":"symbol","externalID":"s:12XestiNumbers6NumberV10simplifiedACvp","modules":[{"name":"XestiNumbers"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simplified","kind":"identifier"},{"text":": `Self`","kind":"text"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"If this number is already in the simplest internal representation, then","type":"text"},{"text":" ","type":"text"},{"text":"this number itself is returned.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A number may be represented internally by a variety of data structures.","type":"text"},{"text":" ","type":"text"},{"text":"For example, there are different data structures for representing","type":"text"},{"text":" ","type":"text"},{"text":"“large” and “small” exact integers, exact fractions, floating-point","type":"text"},{"text":" ","type":"text"},{"text":"values, and complex numbers. Performing a numeric operation may result","type":"text"},{"text":" ","type":"text"},{"text":"in a number with a representation containing extraneous information.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, the  numbers ","type":"text"},{"code":"5\/4","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"3\/4","type":"codeVoice"},{"text":" are represented internally by","type":"text"},{"text":" ","type":"text"},{"text":"data structures that contain the numerator and denominator of each","type":"text"},{"text":" ","type":"text"},{"text":"number. (Something like, ","type":"text"},{"code":"{ numerator: 5, denominator: 4 }","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"{ numerator: 3, denominator: 4 }","type":"codeVoice"},{"text":", respectively.) Adding those numbers","type":"text"},{"text":" ","type":"text"},{"text":"together results in the number ","type":"text"},{"code":"2","type":"codeVoice"},{"text":". However, for efficiency, that result","type":"text"},{"text":" ","type":"text"},{"text":"is also represented internally by a data structure that contains ","type":"text"},{"inlineContent":[{"text":"both","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"a numerator ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" a denominator. (Something like, ","type":"text"},{"code":"{ numerator: 2, denominator: 1 }","type":"codeVoice"},{"text":".) In this case, the ","type":"text"},{"code":"simplified","type":"codeVoice"},{"text":" property would","type":"text"},{"text":" ","type":"text"},{"text":"simplify the internal representation to contain ","type":"text"},{"inlineContent":[{"text":"only","type":"text"}],"type":"emphasis"},{"text":" the (exact)","type":"text"},{"text":" ","type":"text"},{"text":"integer result.","type":"text"}]}]}],"abstract":[{"type":"text","text":"The simplest internal representation of this number."}],"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/XestiNumbers\/documentation\/XestiNumbers\/Number\/simplified","interfaceLanguage":"swift"},"references":{"doc://XestiNumbers/documentation/XestiNumbers/Number":{"identifier":"doc:\/\/XestiNumbers\/documentation\/XestiNumbers\/Number","abstract":[{"text":"A generalized numeric value that supports a “number tower” patterned after","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that in the Scheme programming language."}],"title":"Number","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Number"}],"kind":"symbol","url":"\/documentation\/xestinumbers\/number","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Number"}]},"doc://XestiNumbers/documentation/XestiNumbers/Number/simplified":{"identifier":"doc:\/\/XestiNumbers\/documentation\/XestiNumbers\/Number\/simplified","kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simplified","kind":"identifier"},{"text":": `Self`","kind":"text"}],"abstract":[{"type":"text","text":"The simplest internal representation of this number."}],"type":"topic","url":"\/documentation\/xestinumbers\/number\/simplified","title":"simplified"},"doc://XestiNumbers/documentation/XestiNumbers":{"url":"\/documentation\/xestinumbers","title":"XestiNumbers","abstract":[{"type":"text","text":"A Swift number tower."}],"role":"collection","identifier":"doc:\/\/XestiNumbers\/documentation\/XestiNumbers","type":"topic","kind":"symbol"}}}