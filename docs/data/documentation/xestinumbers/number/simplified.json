{"identifier":{"url":"doc:\/\/XestiNumbers\/documentation\/XestiNumbers\/Number\/simplified","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"simplified"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/XestiNumbers\/documentation\/XestiNumbers\/Number","preciseIdentifier":"s:12XestiNumbers6NumberV","kind":"typeIdentifier","text":"Number"},{"kind":"text","text":" { "},{"text":"get","kind":"keyword"},{"kind":"text","text":" }"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If this number is already in the simplest internal representation, then"},{"type":"text","text":" "},{"type":"text","text":"this number itself is returned."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A number may be represented internally by a variety of data structures."},{"type":"text","text":" "},{"type":"text","text":"For example, there are different data structures for representing"},{"text":" ","type":"text"},{"type":"text","text":"“large” and “small” exact integers, exact fractions, floating-point"},{"type":"text","text":" "},{"text":"values, and complex numbers. Performing a numeric operation may result","type":"text"},{"text":" ","type":"text"},{"text":"in a number with a representation containing extraneous information.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, the  numbers "},{"code":"5\/4","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"3\/4","type":"codeVoice"},{"text":" are represented internally by","type":"text"},{"text":" ","type":"text"},{"text":"data structures that contain the numerator and denominator of each","type":"text"},{"text":" ","type":"text"},{"text":"number. (Something like, ","type":"text"},{"code":"{ numerator: 5, denominator: 4 }","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"{ numerator: 3, denominator: 4 }","type":"codeVoice"},{"text":", respectively.) Adding those numbers","type":"text"},{"text":" ","type":"text"},{"text":"together results in the number ","type":"text"},{"code":"2","type":"codeVoice"},{"type":"text","text":". However, for efficiency, that result"},{"text":" ","type":"text"},{"type":"text","text":"is also represented internally by a data structure that contains "},{"inlineContent":[{"type":"text","text":"both"}],"type":"emphasis"},{"type":"text","text":" "},{"text":"a numerator ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" a denominator. (Something like, "},{"type":"codeVoice","code":"{ numerator: 2, denominator: 1 }"},{"text":".) In this case, the ","type":"text"},{"type":"codeVoice","code":"simplified"},{"type":"text","text":" property would"},{"type":"text","text":" "},{"type":"text","text":"simplify the internal representation to contain "},{"type":"emphasis","inlineContent":[{"type":"text","text":"only"}]},{"type":"text","text":" the (exact)"},{"type":"text","text":" "},{"type":"text","text":"integer result."}]}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"XestiNumbers"}],"symbolKind":"property","extendedModule":"XestiNumbers","externalID":"s:12XestiNumbers6NumberV10simplifiedACvp","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simplified","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Number","kind":"typeIdentifier","preciseIdentifier":"s:12XestiNumbers6NumberV"}],"role":"symbol","title":"simplified"},"hierarchy":{"paths":[["doc:\/\/XestiNumbers\/documentation\/XestiNumbers","doc:\/\/XestiNumbers\/documentation\/XestiNumbers\/Number"]]},"kind":"symbol","abstract":[{"text":"The simplest internal representation of this number.","type":"text"}],"variants":[{"paths":["\/documentation\/xestinumbers\/number\/simplified"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://XestiNumbers/documentation/XestiNumbers/Number/simplified":{"identifier":"doc:\/\/XestiNumbers\/documentation\/XestiNumbers\/Number\/simplified","url":"\/documentation\/xestinumbers\/number\/simplified","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"simplified"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Number","preciseIdentifier":"s:12XestiNumbers6NumberV"}],"title":"simplified","type":"topic","abstract":[{"text":"The simplest internal representation of this number.","type":"text"}],"role":"symbol"},"doc://XestiNumbers/documentation/XestiNumbers/Number":{"identifier":"doc:\/\/XestiNumbers\/documentation\/XestiNumbers\/Number","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Number"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Number"}],"abstract":[{"type":"text","text":"A generalized numeric value that supports a “number tower” patterned after"},{"type":"text","text":" "},{"type":"text","text":"that in the Scheme programming language."}],"type":"topic","title":"Number","url":"\/documentation\/xestinumbers\/number"},"doc://XestiNumbers/documentation/XestiNumbers":{"identifier":"doc:\/\/XestiNumbers\/documentation\/XestiNumbers","url":"\/documentation\/xestinumbers","kind":"symbol","title":"XestiNumbers","type":"topic","abstract":[{"text":"A Swift number tower.","type":"text"}],"role":"collection"}}}