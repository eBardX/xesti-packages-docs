ussion","type":"heading"},{"inlineContent":[{"text":"This display strategy formats the exact fraction as the combination","type":"text"},{"text":" ","type":"text"},{"text":"of a nonzero integer and a proper fraction (meaning the numerator","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is less than the denominator). The integer and fraction parts are"},{"text":" ","type":"text"},{"text":"separated by a space, unless one of the parts is zero. By default, a","type":"text"},{"type":"text","text":" "},{"text":"zero integer part is suppressed. A zero fraction part is always","type":"text"},{"type":"text","text":" "},{"type":"text","text":"suppressed."}],"type":"paragraph"},{"syntax":"swift","code":["let formatStyle = Number.FormatStyle(locale: Locale(\"en_US\"))","                        .fractionDisplay(strategy: .mixed())","","formatStyle.format(Number(numerator: -5, denominator: 1))    \/\/ -5","formatStyle.format(Number(numerator: 355, denominator: 113)) \/\/ 3 16\/113","formatStyle.format(Number(numerator: 7, denominator: 8))     \/\/ 7\/8"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To always show the integer part, even when it is zero, pass "},{"type":"codeVoice","code":"true"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiNumbers\/documentation\/XestiNumbers\/Number\/FractionDisplayStrategy\/mixed(alwaysShowInteger:)"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let formatStyle = Number.FormatStyle(locale: Locale(\"en_US\"))","                        .fractionDisplay(strategy: .mixed(alwaysShowInteger: true))","","formatStyle.format(Number(numerator: -5, denominator: 1))    \/\/ -5","formatStyle.format(Number(numerator: 355, denominator: 113)) \/\/ 3 16\/113","formatStyle.format(Number(numerator: 7, denominator: 8))     \/\/ 0 7\/8"],"type":"codeListing"}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":