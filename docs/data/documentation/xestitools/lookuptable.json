ator"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"Unlike a dictionary, a ","type":"text"},{"code":"LookupTable","type":"codeVoice"},{"text":" instance does not require an exact key","type":"text"},{"text":" ","type":"text"},{"text":"match. Each entry is a (key, value) anchor, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/subscript(_:)","type":"reference"},{"text":" ","type":"text"},{"text":"interpolates between the two entries that bracket a queried key. Every key","type":"text"},{"text":" ","type":"text"},{"text":"within range of the lookup table therefore yields a meaningful value, not","type":"text"},{"text":" ","type":"text"},{"text":"just the keys that were explicitly inserted.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Given a key, the lookup table:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Finds the two entries that bracket the key."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Computes the input fraction via"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/InterpolatableKey\/fraction(from:through:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the input fraction through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/Interpolator\/checkedInterpolate(_:)"},{"type":"text","text":" "},{"type":"text","text":"to obtain the output fraction."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Blends the values of the bracketing entries via"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/InterpolatableValue\/value(of:from:through:)"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"Keys beyond the last entry return the value of the last entry; keys before","type":"text"},{"text":" ","type":"text"},{"text":"the first entry return the value of the first entry; an empty lookup table","type":"text"},{"text":" ","type":"text"},{"text":"returns ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/defaultValue","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Two entries may share the same key to model an ","type":"text"},{"inlineContent":[{"type":"text","text":"immediate"}],"type":"emphasis"},{"text":" transition:","type":"text"},{"text":" ","type":"text"},{"text":"values approaching that key from below interpolate toward the value of the","type":"text"},{"text":" ","type":"text"},{"text":"first entry, while querying that key exactly snaps to the value of the","type":"text"},{"text":" ","type":"text"},{"text":"second entry.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The same ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/interpolator","type":"reference"},{"text":" is applied to every segment between adjacent","type":"text"},{"text":" ","type":"text"},{"text":"entries. Some examples of what a lookup table can model:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"ADSR envelope"}]},{"type":"text","text":" — entries keyed by time mark the boundaries of each"},{"type":"text","text":" "},{"type":"text","text":"envelope stage (attack, decay, sustain, release); the interpolator"},{"type":"text","text":" "},{"type":"text","text":"controls whether the transitions are linear, exponential, and so on."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Keyframe animation"}]},{"type":"text","text":" — entries keyed by time anchor a property (position,"},{"type":"text","text":" "},{"type":"text","text":"opacity, scale) at specific moments; all in-between frames are derived via"},{"type":"text","text":" "},{"type":"text","text":"the interpolator."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Color gradient"}]},{"type":"text","text":" — entries keyed by a scalar position (0–1) define color"},{"type":"text","text":" "},{"type":"text","text":"stops; any position between stops yields a blended color."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/subscript(_:)","type":"reference"},{"text":" for lookups, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/insert(key:value:extras:)","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/remove(key:value:extras:)","type":"reference"},{"text":", and ","type":"text"},{"type":"reference","identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/merge(with:)","isActive":true},{"type":"text","text":" to mutate the lookup"},{"type":"text","text":" "},{"type":"text","text":"table."}],"type":"paragraph"}]}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LookupTable","kind":"identifier"}],"modules":[{"name":"XestiTools"}],"roleHeading":"Structure","title":"LookupTable","symbolKind":"struct","navigatorTitle":[{"text":"LookupTable","kind":"identifier"}],"externalID":"s:10XestiTools11LookupTableV","role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://XestiTools/do