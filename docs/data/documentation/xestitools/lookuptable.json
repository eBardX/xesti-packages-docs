{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LookupTable","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Key","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Interp","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/InterpolatableKey","preciseIdentifier":"s:10XestiTools17InterpolatableKeyP","text":"InterpolatableKey","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/InterpolatableValue","preciseIdentifier":"s:10XestiTools19InterpolatableValueP","text":"InterpolatableValue","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Interp","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/Interpolator","preciseIdentifier":"s:10XestiTools12InterpolatorP","text":"Interpolator","kind":"typeIdentifier"}]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike a dictionary, a "},{"code":"LookupTable","type":"codeVoice"},{"type":"text","text":" instance does not require an exact key"},{"type":"text","text":" "},{"type":"text","text":"match. Each entry is a (key, value) anchor, and "},{"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/subscript(_:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"interpolates between the two entries that bracket a queried key. Every key"},{"type":"text","text":" "},{"type":"text","text":"within range of the lookup table therefore yields a meaningful value, not"},{"type":"text","text":" "},{"type":"text","text":"just the keys that were explicitly inserted."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given a key, the lookup table:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Finds the two entries that bracket the key.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Computes the input fraction via","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/InterpolatableKey\/fraction(from:through:)","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Maps the input fraction through ","type":"text"},{"type":"reference","identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/Interpolator\/checkedInterpolate(_:)","isActive":true},{"text":" ","type":"text"},{"text":"to obtain the output fraction.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Blends the values of the bracketing entries via","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/InterpolatableValue\/value(of:from:through:)","isActive":true},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys beyond the last entry return the value of the last entry; keys before"},{"type":"text","text":" "},{"type":"text","text":"the first entry return the value of the first entry; an empty lookup table"},{"type":"text","text":" "},{"type":"text","text":"returns "},{"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/defaultValue","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two entries may share the same key to model an "},{"inlineContent":[{"text":"immediate","type":"text"}],"type":"emphasis"},{"type":"text","text":" transition:"},{"type":"text","text":" "},{"type":"text","text":"values approaching that key from below interpolate toward the value of the"},{"type":"text","text":" "},{"type":"text","text":"first entry, while querying that key exactly snaps to the value of the"},{"type":"text","text":" "},{"type":"text","text":"second entry."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The same "},{"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/interpolator","isActive":true,"type":"reference"},{"type":"text","text":" is applied to every segment between adjacent"},{"type":"text","text":" "},{"type":"text","text":"entries. Some examples of what a lookup table can model:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"ADSR envelope"}],"type":"emphasis"},{"text":" — entries keyed by time mark the boundaries of each","type":"text"},{"text":" ","type":"text"},{"text":"envelope stage (attack, decay, sustain, release); the interpolator","type":"text"},{"text":" ","type":"text"},{"text":"controls whether the transitions are linear, exponential, and so on.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Keyframe animation"}],"type":"emphasis"},{"text":" — entries keyed by time anchor a property (position,","type":"text"},{"text":" ","type":"text"},{"text":"opacity, scale) at specific moments; all in-between frames are derived via","type":"text"},{"text":" ","type":"text"},{"text":"the interpolator.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Color gradient"}],"type":"emphasis"},{"text":" — entries keyed by a scalar position (0–1) define color","type":"text"},{"text":" ","type":"text"},{"text":"stops; any position between stops yields a blended color.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/subscript(_:)","isActive":true,"type":"reference"},{"type":"text","text":" for lookups, and "},{"identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/insert(key:value:extras:)","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/remove(key:value:extras:)","isActive":true},{"text":", and ","type":"text"},{"type":"reference","identifier":"doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/merge(with:)","isActive":true},{"text":" to mutate the lookup","type":"text"},{"text":" ","type":"text"},{"text":"table.","type":"text"}]}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"A lookup table that sorts its entries by key — preserving insertion order"},{"type":"text","text":" "},{"type":"text","text":"when equal — and interpolates between the keys to produce a value for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"any"}]},{"type":"text","text":" "},{"type":"text","text":"key."}],"variants":[{"paths":["\/documentation\/xestitools\/lookuptable"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:10XestiTools11LookupTableV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LookupTable","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LookupTable"}],"title":"LookupTable","symbolKind":"struct","modules":[{"name":"XestiTools"}],"roleHeading":"Structure"},"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/XestiTools\/documentation\/XestiTools\/LookupTable\/init(defaultValue:interpolator:)"],"generated":true},{"title":"Instance Properties","anc